module add8(sum, cout, x, y);

input  [7:0] x, y;
output [7:0] sum;
output cout;

wire [7:0] c;

// LSB uses Half Adder
ha h0(sum[0], c[0], x[0], y[0]);

// Remaining bits use Full Adders
fa f1(sum[1], c[1], x[1], y[1], c[0]);
fa f2(sum[2], c[2], x[2], y[2], c[1]);
fa f3(sum[3], c[3], x[3], y[3], c[2]);
fa f4(sum[4], c[4], x[4], y[4], c[3]);
fa f5(sum[5], c[5], x[5], y[5], c[4]);
fa f6(sum[6], c[6], x[6], y[6], c[5]);
fa f7(sum[7], c[7], x[7], y[7], c[6]);

assign cout = c[7];

endmodule


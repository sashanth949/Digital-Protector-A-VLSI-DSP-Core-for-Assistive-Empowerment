module mac_tb_test;
    // -------------------------------------------------
    // Signals
    // -------------------------------------------------
    reg         clk;
    reg         rst_n;
    reg  [3:0]  a;
    reg  [3:0]  b;
    wire [11:0] accum_out;

    // Reference model
    reg [11:0] expected;

    integer i, j;
    integer error_count;
    integer file_handle;

    // -------------------------------------------------
    // DUT
    // -------------------------------------------------
    mac_unit uut (
        .clk       (clk),
        .rst_n     (rst_n),
        .a         (a),
        .b         (b),
        .accum_out (accum_out)
    );

    // -------------------------------------------------
    // Clock: 10 ns period
    // -------------------------------------------------
    initial clk = 0;
    always #5 clk = ~clk;

    // -------------------------------------------------
    // Main Test Sequence
    // -------------------------------------------------
    initial begin
        file_handle = $fopen("MAC_exhaustive_results.csv", "w");
        $fdisplay(file_handle,
            "Time(ps),rst_n,a,b,product,accum_out,expected,status");

        error_count = 0;
        expected    = 12'd0;

        //================================================
        // 1. BASIC RESET TEST
        //================================================
        $display("\n=== 1. Basic Reset Test ===");
        a     = 0;
        b     = 0;
        rst_n = 0;
        repeat(3) @(posedge clk);
        check_result(12'd0);

        rst_n = 1;
        @(posedge clk);                 // one clean cycle after reset release
        check_result(12'd0);

        //================================================
        // 2. EXHAUSTIVE 4x4 TEST (256 cases)
        //================================================
        $display("\n=== 2. Exhaustive 4x4 MAC Test (256 cases) ===");
        for (i = 0; i < 16; i = i + 1) begin
            for (j = 0; j < 16; j = j + 1) begin
                a = i[3:0];
                b = j[3:0];
                @(posedge clk);         // product is added on this edge
                expected = expected + (i * j);
                check_result(expected);
            end
        end

        //================================================
        // 3. CONTINUOUS ACCUMULATION STRESS TEST
        //================================================
        $display("\n=== 3. Continuous Accumulation Stress Test ===");
        // Reset
        a = 0; b = 0;
        rst_n = 0;
        @(posedge clk);
        expected = 12'd0;
        rst_n = 1;
        @(posedge clk);
        check_result(12'd0);

        for (i = 0; i < 50; i = i + 1) begin
            a = $urandom_range(0,15);
            b = $urandom_range(0,15);
            @(posedge clk);
            expected = expected + (a * b);
            check_result(expected);
        end

        //================================================
        // 4. MAXIMUM PRODUCT + OVERFLOW
        //================================================
        $display("\n=== 4. Maximum Product (15x15) + Overflow Test ===");
        // Reset
        a = 0; b = 0;
        rst_n = 0;
        @(posedge clk);
        expected = 12'd0;
        rst_n = 1;
        @(posedge clk);
        check_result(12'd0);

        a = 15;
        b = 15;
        for (i = 0; i < 25; i = i + 1) begin   // 25 × 225 = 5625 → wraps
            @(posedge clk);
            expected = expected + 12'd225;
            check_result(expected);
        end

        //================================================
        // 5. RESET DURING OPERATION + RECOVERY
        //================================================
        $display("\n=== 5. Reset During Operation + Recovery ===");

        // Accumulate a few more values
        a = 10; b = 10;
        repeat(3) begin
            @(posedge clk);
            expected = expected + 12'd100;
            check_result(expected);
        end

        // Asynchronous reset
        rst_n = 0;
        #1;                             // let reset propagate
        expected = 12'd0;
        check_result(12'd0);

        // Release reset cleanly
        a = 0; b = 0;
        rst_n = 1;
        @(posedge clk);
        check_result(12'd0);

        // Recovery
        a = 7; b = 8;
        @(posedge clk);
        expected = 12'd56;
        check_result(expected);

        //================================================
        // FINAL REPORT
        //================================================
        $display("\n======================================");
        if (error_count == 0)
            $display("*** ALL TESTS PASSED ***");
        else
            $display("*** FAILED: %0d errors ***", error_count);
        $display("Total errors = %0d", error_count);
        $display("======================================\n");

        $fclose(file_handle);
        $finish;
    end

    // -------------------------------------------------
    // Self-checking task
    // -------------------------------------------------
    task check_result;
        input [11:0] exp;
        begin
            #1;   // allow non-blocking update to settle
            if (accum_out !== exp) begin
                $display("ERROR @ %0t : a=%0d b=%0d product=%0d | got=%0d (0x%03h) | expected=%0d (0x%03h)",
                         $time, a, b, a*b, accum_out, accum_out, exp, exp);
                error_count = error_count + 1;
                $fdisplay(file_handle, "%0t,%b,%0d,%0d,%0d,%0d,%0d,FAIL",
                          $time, rst_n, a, b, a*b, accum_out, exp);
            end
            else begin
                $fdisplay(file_handle, "%0t,%b,%0d,%0d,%0d,%0d,%0d,PASS",
                          $time, rst_n, a, b, a*b, accum_out, exp);
            end
        end
    endtask
endmodule

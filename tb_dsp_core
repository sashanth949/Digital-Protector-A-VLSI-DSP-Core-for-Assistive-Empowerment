module tb_dsp_core;

reg clk, rst_n;
reg [7:0] a_in, b_in;
reg c_in;
reg [3:0] op_code;
reg mode_sel;
wire [15:0] result_out;
wire carry, zero, negative;
integer errors;
dsp_core dut(
    .clk(clk),
    .rst_n(rst_n),
    .a_in(a_in),
    .b_in(b_in),
    .c_in(c_in),
    .op_code(op_code),
    .mode_sel(mode_sel),
    .result_out(result_out),
    .carry(carry),
    .zero(zero),
    .negative(negative)
);

initial begin
    clk = 0;
    forever #5 clk = ~clk;
end
initial begin

    errors = 0;

    // Initialize
    clk = 0;
    rst_n = 0;
    mode_sel = 0;
    a_in = 0;
    b_in = 0;
    c_in = 0;
    op_code = 0;

    // Reset
    #12;
    rst_n = 1;

    // -----------------------------
    // MAC TEST 1 : 3 x 2 = 6
    // -----------------------------
    mode_sel = 0;
    a_in = 8'd3;
    b_in = 8'd2;

    @(posedge clk); #1;

    if(result_out == 16'h0006)
        $display("PASS : MAC 3x2");
    else begin
        $display("FAIL : MAC 3x2 -> %d", $signed(result_out));
        errors = errors + 1;
    end

    // -----------------------------
    // MAC TEST 2 : -3 x 2
    // Accumulator should become 0
    // -----------------------------
    a_in = 8'b00001101;   // lower nibble = 1101 (-3)
    b_in = 8'd2;

    @(posedge clk); #1;

    if(result_out == 16'h0000 && zero)
        $display("PASS : MAC accumulate");
    else begin
        $display("FAIL : MAC accumulate");
        errors = errors + 1;
    end

    // -----------------------------
    // ALU ADD
    // -----------------------------
    mode_sel = 1;
    a_in = 8'h25;
    b_in = 8'h10;
    c_in = 0;
    op_code = 4'b0001;

    #10;

    if(result_out == 16'h0035)
        $display("PASS : ALU ADD");
    else begin
        $display("FAIL : ALU ADD");
        errors = errors + 1;
    end

    // -----------------------------
    // ALU XOR
    // -----------------------------
    a_in = 8'hAA;
    b_in = 8'h55;
    op_code = 4'b1000;

    #10;

    if(result_out == 16'h00FF)
        $display("PASS : ALU XOR");
    else begin
        $display("FAIL : ALU XOR");
        errors = errors + 1;
    end

    // -----------------------------
    // ALU ZERO FLAG
    // -----------------------------
    a_in = 8'h55;
    b_in = 8'h55;
    op_code = 4'b1000;

    #10;

    if(result_out == 16'h0000 && zero)
        $display("PASS : Zero Flag");
    else begin
        $display("FAIL : Zero Flag");
        errors = errors + 1;
    end

    // -----------------------------
    // Final Report
    // -----------------------------
    $display("--------------------------");

    if(errors == 0)
        $display("ALL DSP TESTS PASSED");
    else
        $display("DSP TEST FAILED : %0d errors", errors);

    $display("--------------------------");

    $finish;
end
endmodule

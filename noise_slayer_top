module noise_slayer_top(
input clk,
input  rst_n,
    // 4-bit microphone sample
input  signed [3:0] sample_in,
    // Gain control
input  [7:0] gain_value,
output signed [15:0] enhanced_out
);
    // FIR output
wire signed [11:0] fir_out;
    // 8-bit value sent into DSP Core
reg signed [7:0] dsp_input;
    // Status outputs
wire carry;
wire zero;
wire negative;
//--------------------------------------------------
// FIR Filter
//--------------------------------------------------
fir_filter FIR(
        .clk(clk),
        .rst(~rst_n),          // FIR uses active-high reset
        .sample_in(sample_in),
        .sample_out(fir_out)
    );
    //--------------------------------------------------
    // 12-bit → 8-bit saturation
    //--------------------------------------------------
always @(*) begin
if(fir_out > 12'sd127)
dsp_input = 8'sd127;
else if(fir_out < -12'sd128)
dsp_input = -8'sd128;
else
dsp_input = fir_out[7:0];
end
    //--------------------------------------------------
    // Digital Protector DSP Core
    //--------------------------------------------------
    dsp_core_signed DSP(
        .clk(clk),
        .rst_n(rst_n),
        .a_in(dsp_input),
        .b_in(gain_value),
        .c_in(1'b0),
        .op_code(4'b0000),      // ADD = Gain adjustment
        .mode_sel(1'b1),        // Use ALU path
        .result_out(enhanced_out),
        .carry(carry),
        .zero(zero),
        .negative(negative)
    );
endmodule


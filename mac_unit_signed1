module mac_unit_signed1(
    input  wire       clk,
    input  wire       rst_n,
    input  wire [3:0] a,
    input  wire [3:0] b,
    output reg [11:0] accum_out
);

    // -----------------------------------------------
    // 1. Baugh-Wooley signed multiplier
    // -----------------------------------------------
    wire [7:0] product;

    b_w multiplier_inst (
        .p(product),
        .a(a),
        .b(b)
    );

    // -----------------------------------------------
    // 2. Sign-extend 8-bit product to 12 bits
    // -----------------------------------------------
    wire [11:0] product_ext;

    assign product_ext = {{4{product[7]}}, product};

    // -----------------------------------------------
    // 3. Accumulation
    // -----------------------------------------------
    wire [11:0] next_accum;

    assign next_accum = accum_out + product_ext;

    // -----------------------------------------------
    // 4. Accumulator register
    // -----------------------------------------------
    always @(posedge clk or negedge rst_n) begin

        if (!rst_n)
            accum_out <= 12'b0;

        else
            accum_out <= next_accum;

    end

endmodule

module tb_wm;
reg[3:0]a;
reg[3:0]b;
reg clk;
wire[7:0]p;
w_m uut(
.p(p),
.a(a),
.b(b),
.clk(clk)
);
always #5 clk=~clk;
initial begin
clk=0;
a=0;
b=0;
#110;
a=4'd10;b=4'd13;
repeat(2) @(posedge clk);
$display("10 x 13=%d",p);
a=4'd7;b=4'd5;
repeat(2) @(posedge clk);
$display("7 x 5=%d",p);
#20 $stop;
end
endmodule

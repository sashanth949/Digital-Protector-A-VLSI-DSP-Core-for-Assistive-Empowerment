`timescale 1ns/1ps

module noise_slayer_tb;
reg clk;
reg rst_n;
reg signed [3:0] sample_in;
reg [7:0] gain_value;
wire signed [15:0] enhanced_out;

reg signed [3:0]  input_mem  [0:399];
reg signed [11:0] golden_mem [0:399];

integer i;
integer errors;
integer logfile;
integer k;
reg signed [15:0] expected;

//====================================================
// DUT
//====================================================
noise_slayer_top DUT(
    .clk(clk),
    .rst_n(rst_n),
    .sample_in(sample_in),
    .gain_value(gain_value),
    .enhanced_out(enhanced_out)
);

//====================================================
// Clock
//====================================================
initial clk = 0;
always #5 clk = ~clk;

//====================================================
// Test
//====================================================
initial begin
    $readmemh("input_audio.mem", input_mem);
    $readmemh("golden_output.mem", golden_mem);

    logfile = $fopen("NoiseSlayer_Verification.csv", "w");
    $fwrite(logfile, "Sample,Input,Enhanced_Out,Expected,Status\n");

    rst_n      = 0;
    sample_in  = 0;
    gain_value = 8'd0;
    errors     = 0;

    // Reset
    repeat(2) @(posedge clk);
    rst_n = 1;

    // Feed 400 samples
    for (i = 0; i < 400; i = i + 1) begin
        sample_in = input_mem[i];
        @(posedge clk);

        if (i > 0) begin
            expected = {{4{golden_mem[i-1][11]}}, golden_mem[i-1]};
            if (enhanced_out == expected) begin
                $display("PASS @ %0d : DUT=%0d Expected=%0d", i-1, enhanced_out, expected);
                $fwrite(logfile, "%0d,%0d,%0d,%0d,PASS\n", i-1, input_mem[i-1], enhanced_out, expected);
            end else begin
                $display("Mismatch @ %0d : DUT=%0d Expected=%0d", i-1, enhanced_out, expected);
                $fwrite(logfile, "%0d,%0d,%0d,%0d,FAIL\n", i-1, input_mem[i-1], enhanced_out, expected);
                errors = errors + 1;
            end
        end
    end

    // Final delayed sample
    @(posedge clk);
    expected = {{4{golden_mem[399][11]}}, golden_mem[399]};
    if (enhanced_out == expected) begin
        $display("PASS @ 399 : DUT=%0d Expected=%0d", enhanced_out, expected);
        $fwrite(logfile, "399,%0d,%0d,%0d,PASS\n", input_mem[399], enhanced_out, expected);
    end else begin
        $display("Mismatch @ 399 : DUT=%0d Expected=%0d", enhanced_out, expected);
        $fwrite(logfile, "399,%0d,%0d,%0d,FAIL\n", input_mem[399], enhanced_out, expected);
        errors = errors + 1;
    end

    $fclose(logfile);

    if (errors == 0) begin
        $display("====================================");
        $display("NOISE SLAYER TEST PASSED");
        $display("400 / 400 samples matched");
        $display("====================================");
    end else begin
        $display("FAILED : %0d mismatches", errors);
    end

    // ================= IMPULSE / LATENCY TEST =================
    // Runs only after the main 400-sample test is fully done,
    // so there's no signal contention.
    $display("========================================");
    $display("IMPULSE RESPONSE / LATENCY TEST");
    $display("========================================");

    rst_n      = 0;
    sample_in  = 0;
    gain_value = 8'd0;
    repeat(2) @(posedge clk);
    rst_n = 1;
    @(posedge clk);

    sample_in = 4'sd7;
    $display("Cycle 0 : APPLIED sample_in = %0d", sample_in);
    @(posedge clk);
    sample_in = 0;

    for (k = 1; k <= 10; k = k + 1) begin
        @(posedge clk);
        $display("Cycle %0d : enhanced_out = %0d %s",
                  k, enhanced_out,
                  (k == 1) ? "<-- LATENCY = 1 CYCLE (first response)" : "");
    end
    $display("========================================");

    $finish;
end

endmodule

module mac_tb();

// Inputs are declared as registers (reg)
reg clk;
reg rst_n;
reg [3:0] a;
reg [3:0] b;

// Outputs are declared as wires
wire [11:0] accum_out;
integer file_handle;

// 1. Instantiate the Unit Under Test (UUT)
mac_unit uut (
    .clk(clk),
    .rst_n(rst_n),
    .a(a),
    .b(b),
    .accum_out(accum_out)
);

// 2. Generate a Clock Signal (Period = 10ns, 100MHz clock)
always begin
    #5 clk = ~clk;
end
initial begin
    file_handle = $fopen("MAC_simulation_results.csv", "w");
    $fdisplay(file_handle, "Time(ps),clk,rst_n,a,b,product,accum_out_dec,accum_out_hex");

    $fmonitor(file_handle, "%0t,%b,%b,%0d,%0d,%0d,%0d,0x%03h",
               $time, clk, rst_n, a, b, uut.product, accum_out, accum_out);

    // -------- Stimulus --------
    clk   = 0;
    rst_n = 0;
    a     = 0;
    b     = 0;

    repeat(2) @(posedge clk);   // hold reset
    rst_n = 1;
    @(posedge clk);

    // First sequence
    a = 4'd3; b = 4'd4; @(posedge clk);
    a = 4'd2; b = 4'd5; @(posedge clk);
    a = 4'd7; b = 4'd2; @(posedge clk);
    a = 4'd0; b = 4'd0; @(posedge clk);

    // Mid-reset
    rst_n = 0; @(posedge clk);
    rst_n = 1; @(posedge clk);

    // Second sequence
    a = 4'd7; b = 4'd2; @(posedge clk);
    a = 4'd0; b = 4'd0; @(posedge clk);

    // Short settle time
    repeat(3) @(posedge clk);

    $fclose(file_handle);
    $display("Simulation finished. Results saved to MAC_simulation_results.csv");
    $finish;
end
endmodule

